<?xml version="1.0" encoding="utf-8"?>
<config addfieldprefix="SuperSoft\Component\Smartbrowser\Administrator\Field">
    <inlinehelp button="show" />
    <fieldset name="visuals" label="COM_SMARTBROWSER_TAB_RESOURCES">
        <fieldset name="thumbnail_options" label="COM_SMARTBROWSER_THUMBNAIL_OPTIONS">
            <field name="image_background" fieldset="thumbnail_options" type="list" default="auto" label="COM_SMARTBROWSER_VISUAL_BACKGROUND" description="COM_SMARTBROWSER_VISUAL_BACKGROUND_DESC"><option value="auto">COM_SMARTBROWSER_VISUAL_AUTO</option><option value="transparent">COM_SMARTBROWSER_VISUAL_TRANSPARENT</option><option value="checkerboard">COM_SMARTBROWSER_VISUAL_CHECKERBOARD</option></field>
        <field name="visual_global" type="visualappearance" parentclass="sb-appearance-field" filter="raw" label="COM_SMARTBROWSER_VISUAL_GLOBAL" description="COM_SMARTBROWSER_VISUAL_GLOBAL_DESC" />
        <field name="visual_media" type="visualappearance" adapter="media" parentclass="sb-appearance-field" filter="raw" label="COM_SMARTBROWSER_ADAPTER_MEDIA" description="COM_SMARTBROWSER_VISUAL_ADAPTER_DESC" />
        <field name="visual_articles" type="visualappearance" adapter="articles" parentclass="sb-appearance-field" filter="raw" label="COM_SMARTBROWSER_ADAPTER_ARTICLES" description="COM_SMARTBROWSER_VISUAL_ADAPTER_DESC" />
        <field name="visual_featured_articles" type="visualappearance" adapter="featured_articles" parentclass="sb-appearance-field" filter="raw" label="COM_SMARTBROWSER_ADAPTER_FEATURED_ARTICLES" description="COM_SMARTBROWSER_VISUAL_ADAPTER_DESC" />
        <field name="visual_categories" type="visualappearance" adapter="categories" parentclass="sb-appearance-field" filter="raw" label="COM_SMARTBROWSER_ADAPTER_CATEGORIES" description="COM_SMARTBROWSER_VISUAL_ADAPTER_DESC" />
        <field name="visual_menus" type="visualappearance" adapter="menus" parentclass="sb-appearance-field" filter="raw" label="COM_SMARTBROWSER_ADAPTER_MENUS" description="COM_SMARTBROWSER_VISUAL_ADAPTER_DESC" />
        <field name="visual_tags" type="visualappearance" adapter="tags" parentclass="sb-appearance-field" filter="raw" label="COM_SMARTBROWSER_ADAPTER_TAGS" description="COM_SMARTBROWSER_VISUAL_ADAPTER_DESC" />
        <field name="visual_articles_by_tag" type="visualappearance" adapter="articles_by_tag" parentclass="sb-appearance-field" filter="raw" label="COM_SMARTBROWSER_ADAPTER_ARTICLES_BY_TAG" description="COM_SMARTBROWSER_VISUAL_ADAPTER_DESC" />
        <field name="visual_users" type="visualappearance" adapter="users" parentclass="sb-appearance-field" filter="raw" label="COM_SMARTBROWSER_ADAPTER_USERS" description="COM_SMARTBROWSER_VISUAL_ADAPTER_DESC" />
        </fieldset>
        <fieldset name="selection_options" label="COM_SMARTBROWSER_SELECTION_OPTIONS">
            <field name="selection_show_unavailable" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_SHOW_UNAVAILABLE" description="COM_SMARTBROWSER_SHOW_UNAVAILABLE_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="selection_unavailable_image_enabled" type="radio" layout="joomla.form.field.radio.switcher" default="0" showon="selection_show_unavailable:1" label="COM_SMARTBROWSER_UNAVAILABLE_IMAGE_ENABLED" description="COM_SMARTBROWSER_UNAVAILABLE_IMAGE_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="selection_unavailable_image" type="media" types="images" directory="images" showon="selection_show_unavailable:1[AND]selection_unavailable_image_enabled:1" label="COM_SMARTBROWSER_UNAVAILABLE_IMAGE" description="COM_SMARTBROWSER_UNAVAILABLE_IMAGE_DESC" />
            <field name="selection_unavailable_text" type="text" filter="string" maxlength="255" default="" showon="selection_show_unavailable:1" label="COM_SMARTBROWSER_UNAVAILABLE_TEXT" description="COM_SMARTBROWSER_UNAVAILABLE_TEXT_DESC" />
            <field name="selection_unavailable_icon_enabled" type="radio" layout="joomla.form.field.radio.switcher" default="1" showon="selection_show_unavailable:1" label="COM_SMARTBROWSER_UNAVAILABLE_ICON_ENABLED" description="COM_SMARTBROWSER_UNAVAILABLE_ICON_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="selection_unavailable_icon" type="icon" default="fas fa-ban" showon="selection_show_unavailable:1[AND]selection_unavailable_icon_enabled:1" label="COM_SMARTBROWSER_UNAVAILABLE_ICON" description="COM_SMARTBROWSER_UNAVAILABLE_ICON_DESC" />
        </fieldset>
    </fieldset>
    <fieldset name="icons" label="COM_SMARTBROWSER_OPTIONS_ICONS">
        <fieldset name="icon_settings" label="COM_SMARTBROWSER_OPTIONS_ICON_APPEARANCE">
        <field name="icon_profiles" type="iconprofiles" filter="raw" label="COM_SMARTBROWSER_CUSTOMIZE_ICONS" description="COM_SMARTBROWSER_OPTIONS_ICONS_DESC" />
        </fieldset>
        <fieldset name="preferences_grid" label="COM_SMARTBROWSER_GRID_SIZES">
            <field name="grid_width_sm" type="gridwidth" parentclass="sb-grid-width-row" filter="integer" default="120" min="80" max="800" step="10" label="COM_SMARTBROWSER_GRID_SIZE_SMALL" description="COM_SMARTBROWSER_GRID_SIZE_DESC" />
            <field name="grid_width_md" type="gridwidth" parentclass="sb-grid-width-row" filter="integer" default="180" min="80" max="800" step="10" label="COM_SMARTBROWSER_GRID_SIZE_MEDIUM" description="COM_SMARTBROWSER_GRID_SIZE_DESC" />
            <field name="grid_width_lg" type="gridwidth" parentclass="sb-grid-width-row" filter="integer" default="280" min="80" max="800" step="10" label="COM_SMARTBROWSER_GRID_SIZE_LARGE" description="COM_SMARTBROWSER_GRID_SIZE_DESC" />
            <field name="grid_width_xl" type="gridwidth" parentclass="sb-grid-width-row" filter="integer" default="420" min="80" max="800" step="10" label="COM_SMARTBROWSER_GRID_SIZE_EXTRA_LARGE" description="COM_SMARTBROWSER_GRID_SIZE_DESC" />
        </fieldset>
    </fieldset>
    <fieldset name="context" label="COM_SMARTBROWSER_TAB_BROWSERS">
        <fieldset name="default_view_state" label="COM_SMARTBROWSER_DEFAULT_VIEW_STATE">
            <field name="default_published" type="radio" layout="joomla.form.field.radio.switcher" default="1" disabled="true" parentclass="sb-fixed-publication-state" label="COM_SMARTBROWSER_FILTER_PUBLISHED" description="COM_SMARTBROWSER_DEFAULT_PUBLISHED_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="default_unpublished" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_SMARTBROWSER_FILTER_UNPUBLISHED" description="COM_SMARTBROWSER_DEFAULT_UNPUBLISHED_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="default_archived" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_SMARTBROWSER_FILTER_ARCHIVED" description="COM_SMARTBROWSER_DEFAULT_ARCHIVED_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="default_trashed" type="radio" layout="joomla.form.field.radio.switcher" default="0" disabled="true" parentclass="sb-fixed-publication-state" label="COM_SMARTBROWSER_FILTER_TRASHED" description="COM_SMARTBROWSER_DEFAULT_TRASHED_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
        </fieldset>
        <fieldset name="preferences_display" label="COM_SMARTBROWSER_RESET_PREFERENCES" description="COM_SMARTBROWSER_RESET_PREFERENCES_DESC">
        <field name="preferences_reset_token" type="preferencesreset" label="COM_SMARTBROWSER_RESET_PREFERENCES" description="COM_SMARTBROWSER_RESET_PREFERENCES_DESC" />
        </fieldset>
        <fieldset name="context_site" label="COM_SMARTBROWSER_OPTIONS_CONTEXT_SITE" description="COM_SMARTBROWSER_OPTIONS_CONTEXT_DESC">
            <field name="context_categories_site" description="COM_SMARTBROWSER_CONTEXT_CATEGORIES_DESC" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_CONTEXT_CATEGORIES_LABEL"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="context_tags_site" description="COM_SMARTBROWSER_CONTEXT_TAGS_DESC" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_CONTEXT_TAGS_LABEL"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="context_menus_site" description="COM_SMARTBROWSER_CONTEXT_MENUS_DESC" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_CONTEXT_MENUS_LABEL"><option value="0">JNO</option><option value="1">JYES</option></field>
        </fieldset>
        <fieldset name="context_admin" label="COM_SMARTBROWSER_OPTIONS_CONTEXT_ADMIN">
            <field name="context_categories_admin" description="COM_SMARTBROWSER_CONTEXT_CATEGORIES_DESC" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_CONTEXT_CATEGORIES_LABEL"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="context_tags_admin" description="COM_SMARTBROWSER_CONTEXT_TAGS_DESC" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_CONTEXT_TAGS_LABEL"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="context_menus_admin" description="COM_SMARTBROWSER_CONTEXT_MENUS_DESC" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_CONTEXT_MENUS_LABEL"><option value="0">JNO</option><option value="1">JYES</option></field>
        </fieldset>

    </fieldset>
    <fieldset name="resource_editors" label="COM_SMARTBROWSER_TAB_EDITORS">
        <fieldset name="editor_open_behavior" label="COM_SMARTBROWSER_EDITOR_OPEN_BEHAVIOR">
            <field name="editor_site" type="list" default="modal" label="COM_SMARTBROWSER_OPTIONS_CONTEXT_SITE" description="COM_SMARTBROWSER_EDITOR_SITE_DESC"><option value="modal">COM_SMARTBROWSER_EDITOR_MODAL</option><option value="page">COM_SMARTBROWSER_EDITOR_PAGE</option></field>
            <field name="editor_admin" type="list" default="modal" label="COM_SMARTBROWSER_OPTIONS_CONTEXT_ADMIN" description="COM_SMARTBROWSER_EDITOR_ADMIN_DESC"><option value="modal">COM_SMARTBROWSER_EDITOR_MODAL</option><option value="page">COM_SMARTBROWSER_EDITOR_PAGE</option></field>
        </fieldset>
        <fieldset name="resource_editor_articles" label="COM_SMARTBROWSER_ADAPTER_ARTICLES">
            <field name="article_links_layout" type="list" default="slots" label="COM_SMARTBROWSER_ARTICLE_LINKS_LAYOUT" description="COM_SMARTBROWSER_ARTICLE_LINKS_LAYOUT_DESC">
                <option value="slots">COM_SMARTBROWSER_ARTICLE_LINKS_SLOTS</option>
                <option value="list">COM_SMARTBROWSER_ARTICLE_LINKS_LIST</option>
            </field>
            <field name="article_link_adapters" type="list" multiple="true" default="articles,menus" label="COM_SMARTBROWSER_ARTICLE_LINK_ADAPTERS" description="COM_SMARTBROWSER_ARTICLE_LINK_ADAPTERS_DESC">
                <option value="articles">COM_SMARTBROWSER_ADAPTER_ARTICLES</option><option value="categories">COM_SMARTBROWSER_ADAPTER_CATEGORIES</option><option value="tags">COM_SMARTBROWSER_ADAPTER_TAGS</option><option value="menus">COM_SMARTBROWSER_ADAPTER_MENUS</option><option value="media">COM_SMARTBROWSER_ADAPTER_MEDIA</option>
            </field>
        </fieldset>
    </fieldset>
    <fieldset name="integration" label="COM_SMARTBROWSER_OPTIONS_INTEGRATION">
        <fieldset name="integration_general" label="">
            <field name="replace_all" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_REPLACE_ALL" description="COM_SMARTBROWSER_REPLACE_ALL_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="integration_hint" type="note" description="COM_SMARTBROWSER_INTEGRATION_HINT_DESC" class="alert alert-info" />
        </fieldset>


        <fieldset name="integration_fields" label="COM_SMARTBROWSER_INTEGRATION_FIELDS" showon="replace_all:0">
            <field name="replace_media_field" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_OPTION_MEDIA_FIELD" description="COM_SMARTBROWSER_REPLACE_MEDIA_FIELD_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="replace_image_selectors" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_IMAGE_SELECTORS" description="COM_SMARTBROWSER_IMAGE_SELECTORS_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
        </fieldset>
        <fieldset name="integration_editor_buttons" label="COM_SMARTBROWSER_INTEGRATION_EDITOR_BUTTONS" showon="replace_all:0">
            <field name="replace_editor_media" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_EDITOR_BUTTON_MEDIA" description="COM_SMARTBROWSER_EDITOR_BUTTON_MEDIA_DESC"><option value="1">JYES</option><option value="0">JNO</option></field>
            <field name="replace_editor_articles" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_EDITOR_BUTTON_ARTICLES" description="COM_SMARTBROWSER_EDITOR_BUTTON_ARTICLES_DESC"><option value="1">JYES</option><option value="0">JNO</option></field>
            <field name="replace_editor_menus" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_EDITOR_BUTTON_MENUS" description="COM_SMARTBROWSER_EDITOR_BUTTON_MENUS_DESC"><option value="1">JYES</option><option value="0">JNO</option></field>
        </fieldset>
        <fieldset name="integration_resource_editors" label="COM_SMARTBROWSER_INTEGRATION_RESOURCE_EDITORS" showon="replace_all:0">
            <field name="replace_editor_article_admin" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_EDITOR_ARTICLE_ADMIN" description="COM_SMARTBROWSER_EDITOR_ARTICLE_ADMIN_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="replace_editor_category_admin" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_EDITOR_CATEGORY_ADMIN" description="COM_SMARTBROWSER_EDITOR_CATEGORY_ADMIN_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="replace_editor_tag_admin" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_EDITOR_TAG_ADMIN" description="COM_SMARTBROWSER_EDITOR_TAG_ADMIN_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="replace_editor_menu_admin" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_EDITOR_MENU_ADMIN" description="COM_SMARTBROWSER_EDITOR_MENU_ADMIN_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="replace_editor_user_admin" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_EDITOR_USER_ADMIN" description="COM_SMARTBROWSER_EDITOR_USER_ADMIN_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="replace_editor_article_site" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_EDITOR_ARTICLE_SITE" description="COM_SMARTBROWSER_EDITOR_ARTICLE_SITE_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
        </fieldset>
        <fieldset name="integration_navigation" label="COM_SMARTBROWSER_INTEGRATION_NAVIGATION" showon="replace_all:0">
            <field name="replace_articles" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_OPTION_REPLACE_ARTICLES" description="COM_SMARTBROWSER_REPLACE_ARTICLES_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="replace_featured_articles" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_OPTION_REPLACE_FEATURED_ARTICLES" description="COM_SMARTBROWSER_REPLACE_FEATURED_ARTICLES_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="replace_categories" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_OPTION_REPLACE_CATEGORIES" description="COM_SMARTBROWSER_REPLACE_CATEGORIES_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="replace_tags" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_OPTION_REPLACE_TAGS" description="COM_SMARTBROWSER_REPLACE_TAGS_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="replace_media" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_OPTION_REPLACE_MEDIA" description="COM_SMARTBROWSER_REPLACE_MEDIA_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="replace_menus" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_OPTION_REPLACE_MENUS" description="COM_SMARTBROWSER_REPLACE_MENUS_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="replace_users" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_OPTION_REPLACE_USERS" description="COM_SMARTBROWSER_REPLACE_USERS_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
        </fieldset>
        <fieldset name="integration_display" label="COM_SMARTBROWSER_GENERAL_INTEGRATIONS">
            <field name="hide_component_menu" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="COM_SMARTBROWSER_HIDE_COMPONENT_MENU" description="COM_SMARTBROWSER_HIDE_COMPONENT_MENU_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
            <field name="show_dashboard_icon" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_SMARTBROWSER_SHOW_DASHBOARD_ICON" description="COM_SMARTBROWSER_SHOW_DASHBOARD_ICON_DESC"><option value="0">JNO</option><option value="1">JYES</option></field>
        </fieldset>
    </fieldset>
    <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
        <field
            name="rules"
            type="rules"
            label="JCONFIG_PERMISSIONS_LABEL"
            filter="rules"
            validate="rules"
            component="com_smartbrowser"
            section="component" description="COM_SMARTBROWSER_PERMISSIONS_DESC"
        />
    </fieldset>
</config>
